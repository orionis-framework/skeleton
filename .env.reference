# Orionis Realtime | Optional environment settings
# Copy only the settings you need into .env. Never commit real keys.
# Typed collections use list:[...] or tuple:(...). Empty assignments become None.

# Application
APP_NAME="Orionis Application"
APP_ENV="development"
APP_KEY=
APP_DEBUG=True
APP_URL="http://127.0.0.1:8000"
APP_TIMEZONE="UTC"
APP_LOCALE="en"
# APP_FALLBACK_LOCALE="en"
# APP_CIPHER="AES-256-CBC"
# APP_MAINTENANCE=False

# WebSocket admission
# Limits apply to each worker process. Message sizes are bytes.
# An empty origin list allows same-origin browser connections.
# Clients without an Origin header are accepted; this policy is not authentication.
# WEBSOCKET_MAX_CONNECTIONS=128
# WEBSOCKET_MAX_MESSAGE_SIZE=1048576
# CORS_ALLOW_ORIGINS="list:['http://127.0.0.1:5173']"
# TRUSTED_PROXIES="list:['127.0.0.1']"
# ALLOWED_HOSTS="list:['127.0.0.1', 'localhost']"

# Hub RPC
# Timeouts apply to ordinary invocations or correlated client results.
# They do not limit the lifetime of a connection or a stream.
# REALTIME_MAX_MESSAGE_SIZE=1048576
# REALTIME_MAX_CONCURRENT_INVOCATIONS=16
# REALTIME_MAX_PENDING_CLIENT_INVOCATIONS=32
# REALTIME_INVOCATION_TIMEOUT=30.0
# REALTIME_CLIENT_RESULT_TIMEOUT=30.0
# REALTIME_BROADCAST_CONCURRENCY=32
# REALTIME_MAX_GROUPS_PER_CONNECTION=64

# Logging
LOG_LEVEL="info"
# LOG_CHANNEL="stack"
# LOG_PATH="storage/logs/stack.log"
# LOG_QUEUE_CAPACITY=0

# Testing
# TESTING_VERBOSITY=2
# TESTING_FAIL_FAST=False
# TESTING_START_DIR="tests"
# TESTING_FILE_PATTERN="test_*.py"
# TESTING_METHOD_PATTERN="test*"
# TESTING_CACHE_RESULTS=False
