# ==============================================================================
# Orionis Framework | Environment Reference
# ==============================================================================
# This file documents available settings; configure .env for your deployment.
# Active entries are example values. Commented entries are optional overrides.
# Uncomment only the settings you need and never commit real credentials or keys.
#
# Values: True / False for booleans; null / None for null values.
# Types: list:[...] and tuple:(...) for collections; str: for literal strings.
# Empty assignments become None. Use "str:" when an empty string is required.
# Interpolation: ${APP_NAME} references another environment variable.

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
#
# Application identity, runtime environment, localization and encryption settings.
# Keep APP_DEBUG disabled in production and APP_KEY private and stable.
#
APP_NAME="Orionis Application"
APP_ENV="development"
APP_DEBUG=True
APP_TIMEZONE="UTC"
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
# APP_LANGUAGE_PATH="resources/lang/"
# APP_CIPHER="AES-256-CBC"
APP_KEY=
APP_MAINTENANCE=False
APP_URL=

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
#
# Optional token authentication for API routes. Create the identity model and its
# business tables before protecting routes, then run orionis auth:migrate.
#
# AUTH_GUARD="token"
# AUTH_MODEL="app.models.user.User"
# AUTH_USERNAME="email"

# Expiration is in minutes; null issues tokens without a preset expiration.
# AUTH_TOKEN_TABLE="personal_access_tokens"
# AUTH_TOKEN_EXPIRATION=null
# AUTH_TOKEN_SECRET_BYTES=40

# ------------------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------------------
#
# Default cache store and file/database backend options. Redis and Memcached
# connection settings are shared and defined in their own blocks below.
# Use a distinct prefix when multiple applications share the same cache service.
#
CACHE_STORE="file"
# CACHE_PREFIX="orionis:"
CACHE_FILE_PATH="storage/framework/cache/data"

# Database store
# DB_CACHE_CONNECTION=null
# DB_CACHE_TABLE="cache"
# DB_CACHE_LOCK_TABLE="cache_locks"

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
#
# Shared connection for Redis-backed cache, rate limiting, queues and scheduler.
# Select Redis separately in each consumer; these settings only define access.
# REDIS_DB selects the logical database. Keep consumer key prefixes distinct.
#
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Memcached
# ------------------------------------------------------------------------------
#
# Connection settings used when a Memcached cache store is selected.
# Keep this service on a private network; it is independent of Redis.
#
MEMCACHED_HOST="127.0.0.1"
MEMCACHED_PORT=11211

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
#
# Default connection and backend-specific options. Built-in drivers are sqlite,
# mysql, pgsql, oracle, sqlserver and redshift. Match the port and charset to
# the selected engine; the server examples below use PostgreSQL conventions.
# Driver-specific options do not select a connection by themselves.
#
# Shared connection settings
DB_CONNECTION="sqlite"
DB_DATABASE="database/database.sqlite"
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_USERNAME="postgres"
# DB_PASSWORD="replace-with-server-credential"
# DB_PREFIX="app_"
# DB_PREFIX_INDEXES=True
# DB_CHARSET applies to the selected driver: mysql=utf8mb4, pgsql/sqlserver=UTF8.
# DB_CHARSET="utf8mb4"

# SQLite
# Local database file and SQLite PRAGMAs; busy timeout is in milliseconds.
# DB_URL=null
# DB_FOREIGN_KEYS="OFF"
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE="DELETE"
# DB_SYNCHRONOUS="NORMAL"

# MySQL
# Socket, collation, SQL mode and storage engine for MySQL connections.
# DB_SOCKET="/var/run/mysqld/mysqld.sock"
# DB_COLLATION="utf8mb4_unicode_ci"
# DB_STRICT=True
# DB_ENGINE="InnoDB"

# PostgreSQL
# Schema search path and TLS mode for PostgreSQL connections.
# DB_SEARCH_PATH="public"
# DB_SSLMODE="prefer"

# Oracle
# Service name, SID, DSN or TNS alias for the Oracle deployment.
# DB_SERVICE_NAME="ORCL"
# DB_SID=null
# DB_DSN=null
# DB_TNS=null
# DB_ENCODING="AL32UTF8"
# DB_NENCODING="AL16UTF16"

# SQL Server
# ODBC driver and transport encryption. Use a trusted certificate in production
# and disable DB_TRUST_SERVER_CERTIFICATE to enforce certificate validation.
# DB_ENCRYPT="yes"
# DB_TRUST_SERVER_CERTIFICATE=True
# DB_ODBC_DRIVER="ODBC Driver 18 for SQL Server"

# Amazon Redshift
# Select DB_CONNECTION="redshift" and DB_PORT=5439 for this backend.
# TLS, IAM and Serverless settings are Redshift-specific; DB_SSLMODE is not used.
# DB_REDSHIFT_SSL=True
# DB_REDSHIFT_SSLMODE="verify-full"
# DB_REDSHIFT_TIMEOUT=30
# DB_REDSHIFT_IAM=False
# DB_REDSHIFT_REGION=null
# DB_REDSHIFT_CLUSTER_IDENTIFIER=null
# DB_REDSHIFT_DB_USER=null
# DB_REDSHIFT_PROFILE=null
# DB_REDSHIFT_IS_SERVERLESS=False
# DB_REDSHIFT_SERVERLESS_WORK_GROUP=null
# DB_REDSHIFT_SERVERLESS_ACCT_ID=null

# ------------------------------------------------------------------------------
# Filesystems
# ------------------------------------------------------------------------------
#
# Default disk, local storage roots and optional cloud storage credentials.
# Private and public roots are separate; do not expose the private directory.
# Enable only the cloud provider settings required by your application.
#
# Local and public
FILESYSTEM_DISK="local"
LOCAL_PATH="storage/app/private"
PUBLIC_PATH="storage/app/public"
PUBLIC_URL="/static"

# Amazon S3
# Bucket credentials and optional endpoint for S3-compatible storage.
# S3_KEY="replace-with-s3-key"
# S3_SECRET="replace-with-s3-credential"
# S3_REGION="us-east-1"
# S3_BUCKET="your-bucket"
# S3_URL=null
# S3_ENDPOINT=null
# S3_USE_PATH_STYLE_ENDPOINT=False

# Azure Blob Storage
# Connection string or account credentials, container and optional public URL.
# AZURE_CONNECTION_STRING="replace-with-azure-connection-string"
# AZURE_ACCOUNT_NAME="your-account"
# AZURE_ACCOUNT_KEY="replace-with-azure-credential"
# AZURE_CONTAINER="your-container"
# AZURE_URL=null

# Google Cloud Storage
# Project, bucket, optional service-account key file and public URL.
# GCS_PROJECT_ID="your-project"
# GCS_KEY_FILE=null
# GCS_BUCKET="your-bucket"
# GCS_URL=null

# ------------------------------------------------------------------------------
# Hashing
# ------------------------------------------------------------------------------
#
# Password hashing algorithm and work factors; this is separate from encryption.
# ARGON_MEMORY is in KiB, ARGON_THREADS controls parallelism and ARGON_TIME is
# an iteration count, not a duration. BCRYPT_ROUNDS is the bcrypt cost factor.
#
HASH_DRIVER="argon2"
# ARGON_MEMORY=65536
# ARGON_THREADS=4
# ARGON_TIME=3
# BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# HTTP
# ------------------------------------------------------------------------------
#
# Request limits, trusted network boundaries and browser security policies.
# Payload sizes are in bytes; rate-limit windows, Redis timeouts and CORS_MAX_AGE
# are in seconds. Review these example settings for your production deployment.
#
# Rate limiting
# Request budget per client key and per window; Redis uses the shared connection.
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# RATE_LIMIT_STORE="memory"
# RATE_LIMIT_MAX_KEYS=10000
# RATE_LIMIT_MAX_EVENTS=100000
# RATE_LIMIT_REDIS_PREFIX="orionis:http:rate-limit"
# RATE_LIMIT_REDIS_TIMEOUT=1

# Request body and uploads
# HTTP_MAX_BODY_SIZE limits the full payload; multipart limits bound files,
# fields, headers and in-memory buffering separately.
# HTTP_MAX_BODY_SIZE=16777216
# HTTP_MAX_BUFFER_SIZE=2097152
# HTTP_MAX_CONCURRENT_REQUESTS=128
# HTTP_MAX_FILES=32
# HTTP_MAX_FIELDS=128
# HTTP_MAX_PART_SIZE=10485760
# HTTP_MAX_FIELD_SIZE=1048576
# HTTP_MAX_PART_HEADER_SIZE=16384
# HTTP_UPLOAD_MEMORY_THRESHOLD=262144
# HTTP_MAX_MULTIPART_MEMORY_SIZE=8388608
# HTTP_MONITOR_DISCONNECTS=False

# Proxies and hosts
# Restrict trusted proxies and allowed hosts to your deployment.
# TRUSTED_PROXIES="list:['127.0.0.1']"
# ALLOWED_HOSTS="list:[]"

# Cross-origin resource sharing (CORS)
# When unset, HTTP allows all origins, methods and headers.
# The explicit empty lists below override those defaults.
# Do not combine wildcard origins with credentialed requests.
CORS_ALLOW_ORIGINS="list:[]"
CORS_ALLOW_ORIGIN_REGEX=None
CORS_ALLOW_METHODS="list:[]"
CORS_ALLOW_HEADERS="list:[]"
CORS_EXPOSE_HEADERS="list:[]"
CORS_ALLOW_CREDENTIALS=False
CORS_MAX_AGE=600

# ------------------------------------------------------------------------------
# Server | Granian Startup Metadata
# ------------------------------------------------------------------------------
#
# These values describe the startup panel only; they do not bind the listener.
# Configure the actual host, port, interface and workers through the server CLI.
#
# GRANIAN_HOST="127.0.0.1"
# GRANIAN_PORT=8000
# GRANIAN_INTERFACE="rsgi"

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
#
# Active logging channel, severity and channel-specific rotation settings.
# LOG_RETENTION uses hours/days/weeks/months for hourly/daily/weekly/monthly
# channels; their defaults are 24/7/4/4. Daily rotation time uses HH:MM.
# Size-based rotation uses LOG_MB_SIZE and LOG_FILES instead of time retention.
#
LOG_CHANNEL="stack"
LOG_LEVEL="info"
# Pending records per handler; zero keeps synchronous logging.
LOG_QUEUE_CAPACITY=0

# Rotation
# Rotating channels require {suffix} in LOG_PATH, e.g. storage/logs/daily_{suffix}.log.
# LOG_PATH="storage/logs/stack.log"
# LOG_RETENTION=4
# LOG_ROTATION_TIME="00:00"
# LOG_MB_SIZE=10
# LOG_FILES=5

# ------------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------------
#
# Default mail transport, sender identity and delivery backend settings.
# MAIL_FROM_NAME supports APP_NAME interpolation. Keep real SMTP credentials
# in the deployment environment or a secret manager.
#
# Sender and SMTP
MAIL_MAILER="smtp"
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# A nonempty MAIL_URL takes precedence over individual SMTP settings.
# The str: prefix preserves an empty string instead of converting it to None.
# MAIL_URL="str:"
MAIL_HOST="localhost"
MAIL_PORT=587
# MAIL_ENCRYPTION="TLS"
# MAIL_USERNAME="replace-with-smtp-user"
# MAIL_PASSWORD="replace-with-smtp-credential"
# MAIL_TIMEOUT=null

# File transport
# Writes messages locally instead of contacting an SMTP server.
# MAIL_FILE_PATH="storage/mail"

# ------------------------------------------------------------------------------
# Queues
# ------------------------------------------------------------------------------
#
# Dispatch backend, connection-specific queue names and worker execution policy.
# Sync executes inline; database and Redis persist jobs for queue workers.
# Retry-after values, worker sleep/timeout and backoff delays are in seconds.
# Keep worker timeout below retry-after to reduce duplicate concurrent execution.
#
# Default connection
QUEUE_CONNECTION="sync"

# Sync
QUEUE_SYNC_QUEUE="default"
QUEUE_SYNC_RETRY_AFTER=90.0

# Database
QUEUE_DB_CONNECTION=null
QUEUE_TABLE="jobs"
QUEUE_DB_QUEUE="default"
QUEUE_DB_RETRY_AFTER=90.0

# Redis
# Uses shared REDIS_* credentials; keep the queue prefix application-specific.
QUEUE_REDIS_PREFIX="orionis:queues"
QUEUE_REDIS_QUEUE="default"
QUEUE_REDIS_RETRY_AFTER=90.0

# Failed jobs
# Failure records are stored separately from the live job queue.
QUEUE_FAILED_DB_CONNECTION=null
QUEUE_FAILED_TABLE="failed_jobs"

# Worker
QUEUE_WORKER_CONCURRENCY=1
QUEUE_WORKER_SLEEP=1.0
QUEUE_WORKER_TIMEOUT=60.0
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF="tuple:(0.0,)"

# ------------------------------------------------------------------------------
# Testing
# ------------------------------------------------------------------------------
#
# Test discovery patterns, console verbosity, fail-fast behavior and result caching.
# Verbosity: 0 = quiet, 1 = progress, 2 = detailed output.
# Discovery overrides affect which tests run; review them before using them in CI.
#
TESTING_VERBOSITY=2
# TESTING_FAIL_FAST=False
# TESTING_START_DIR="tests"
# TESTING_FILE_PATTERN="test_*.py"
# TESTING_METHOD_PATTERN="test*"
# TESTING_CACHE_RESULTS=False
